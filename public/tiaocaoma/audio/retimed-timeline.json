      "voiceFits": true,
      "segments": [
        {
          "id": "rules-02-narr",
          "speaker": "旁白",
          "staticPath": "tiaocaoma/audio/voice/rules-02-narr.mp3",
          "text": "开张才一个月，生意就火得不得了。豆瓣鱼、龙脆骨、驴打滚，一道道民间家常菜，把京城的达官显贵都引来了。",
          "relativeStartFrame": 0,
          "absoluteStartFrame": 144,
          "durationInFrames": 279
        }
      ]
    },
    {
      "id": "rules-03",
      "actId": "rules",
      "oldStartFrame": 432,
      "oldEndFrame": 696,
      "startFrame": 432,
      "endFrame": 696,
      "durationFrames": 264,
      "targetSeconds": 11,
      "actualSeconds": 8.63,
      "deltaSeconds": 0,
      "voiceEndFrame": 208,
      "voiceFits": true,
      "segments": [
        {
          "id": "rules-03-narr",
          "speaker": "旁白",
          "staticPath": "tiaocaoma/audio/voice/rules-03-narr.mp3",
          "text": "这些有身份的人，怕出入小馆子有失体面，常常轻车简从，有的只带一个随从，悄悄来吃。",
          "relativeStartFrame": 0,
          "absoluteStartFrame": 432,
          "durationInFrames": 208
        }
      ]
    },
    {
      "id": "rules-04",
      "actId": "rules",
      "oldStartFrame": 696,
      "oldEndFrame": 960,
      "startFrame": 696,
      "endFrame": 960,
      "durationFrames": 264,
      "targetSeconds": 11,
      "actualSeconds": 9.1,
      "deltaSeconds": 0,
      "voiceEndFrame": 219,
      "voiceFits": true,
      "segments": [
        {
          "id": "rules-04-narr",
          "speaker": "旁白",
          "staticPath": "tiaocaoma/audio/voice/rules-04-narr.mp3",
          "text": "他们的坐骑，就拴在后院马棚里，由店小二加草添料。别看是畜生，待遇一点不比人差。",
          "relativeStartFrame": 0,
          "absoluteStartFrame": 696,
          "durationInFrames": 219
        }
      ]
    },
    {
      "id": "rules-05",
      "actId": "rules",
      "oldStartFrame": 960,
      "oldEndFrame": 1200,
      "startFrame": 960,
      "endFrame": 1200,
      "durationFrames": 240,
      "targetSeconds": 10,
      "actualSeconds": 8.8,
      "deltaSeconds": 0,
      "voiceEndFrame": 212,
      "voiceFits": true,
      "segments": [
        {
          "id": "rules-05-narr",
          "speaker": "旁白",
          "staticPath": "tiaocaoma/audio/voice/rules-05-narr.mp3",
          "text": "马匹一多，怎么排顺序、怎么添草料，就大有学问了。店小二鬼精着呢，您猜怎么着？",
          "relativeStartFrame": 0,
          "absoluteStartFrame": 960,
          "durationInFrames": 212
        }
      ]
    },
    {
      "id": "rules-06",
      "actId": "rules",
      "oldStartFrame": 1200,
      "oldEndFrame": 1536,
      "startFrame": 1200,
      "endFrame": 1536,
      "durationFrames": 336,
      "targetSeconds": 14,
