          "speaker": "旁白",
          "staticPath": "tiaocaoma/audio/voice/rules-01-narr.mp3",
          "text": "话说京城城西，新开了一家饭馆。",
          "relativeStartFrame": 0,
          "absoluteStartFrame": 0,
          "durationInFrames": 84
        }
      ]
    },
    {
      "id": "rules-02",
      "actId": "rules",
      "oldStartFrame": 144,
      "oldEndFrame": 432,
      "startFrame": 144,
      "endFrame": 432,
      "durationFrames": 288,
