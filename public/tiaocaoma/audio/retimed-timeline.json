      "voiceEndFrame": 164,
      "voiceFits": true,
      "segments": [
        {
          "id": "exception-02-narr",
          "speaker": "旁白",
          "staticPath": "tiaocaoma/audio/voice/exception-02-narr.mp3",
          "text": "店小二搭眼一看：贩夫走卒，没什么背景。穿得寒酸，马也瘸。",
          "relativeStartFrame": 0,
          "absoluteStartFrame": 3072,
          "durationInFrames": 164
