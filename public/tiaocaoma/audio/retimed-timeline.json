      "deltaSeconds": 0,
      "voiceEndFrame": 317,
      "voiceFits": true,
      "segments": [
        {
          "id": "rules-06-narr",
          "speaker": "旁白",
          "staticPath": "tiaocaoma/audio/voice/rules-06-narr.mp3",
          "text": "饭馆在城西，食客用完饭大多骑马向东，因此东边为贵。官越大，马排得越靠东，出行越方便。这讲究，比朝堂还清楚。",
          "relativeStartFrame": 0,
          "absoluteStartFrame": 1200,
          "durationInFrames": 317
        }
      ]
    },
    {
      "id": "rules-07",
      "actId": "rules",
      "oldStartFrame": 1536,
      "oldEndFrame": 1848,
      "startFrame": 1536,
      "endFrame": 1848,
      "durationFrames": 312,
      "targetSeconds": 13,
      "actualSeconds": 11.87,
      "deltaSeconds": 0,
      "voiceEndFrame": 285,
      "voiceFits": true,
      "segments": [
        {
          "id": "rules-07-narr",
          "speaker": "旁白",
          "staticPath": "tiaocaoma/audio/voice/rules-07-narr.mp3",
          "text": "草料也分三等：一品二品，吃刚割来的嫩草细粮；三品到五品，只有青草；五品以下，寻常枯草。半点乱不得。",
          "relativeStartFrame": 0,
          "absoluteStartFrame": 1536,
          "durationInFrames": 285
        }
      ]
    },
    {
      "id": "rules-08",
      "actId": "rules",
      "oldStartFrame": 1848,
      "oldEndFrame": 2112,
      "startFrame": 1848,
      "endFrame": 2112,
      "durationFrames": 264,
      "targetSeconds": 11,
