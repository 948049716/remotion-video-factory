        {
          "id": "exception-04-narr",
          "speaker": "旁白",
          "staticPath": "tiaocaoma/audio/voice/exception-04-narr.mp3",
          "text": "店小二接过缰绳，答应得痛快。",
          "relativeStartFrame": 0,
          "absoluteStartFrame": 3480,
          "durationInFrames": 83
        },
        {
          "id": "exception-04-dlg-01",
          "speaker": "刀疤脸",
          "staticPath": "tiaocaoma/audio/voice/exception-04-dlg-01.mp3",
          "text": "好好伺候，可别欺负它啊！",
          "relativeStartFrame": 89,
          "absoluteStartFrame": 3569,
          "durationInFrames": 65
        },
        {
          "id": "exception-04-dlg-02",
          "speaker": "店小二",
          "staticPath": "tiaocaoma/audio/voice/exception-04-dlg-02.mp3",
          "text": "客官说笑了。",
          "relativeStartFrame": 161,
          "absoluteStartFrame": 3641,
          "durationInFrames": 33
        }
      ]
    },
    {
      "id": "exception-05",
      "actId": "exception",
