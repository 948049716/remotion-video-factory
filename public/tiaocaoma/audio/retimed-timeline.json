      "segments": [
        {
          "id": "exception-10-narr",
          "speaker": "旁白",
          "staticPath": "tiaocaoma/audio/voice/exception-10-narr.mp3",
          "text": "店小二腰弯得像虾米。",
          "relativeStartFrame": 0,
          "absoluteStartFrame": 4944,
          "durationInFrames": 60
        },
        {
          "id": "exception-10-dlg-01",
          "speaker": "店小二",
          "staticPath": "tiaocaoma/audio/voice/exception-10-dlg-01.mp3",
          "text": "大人别误会，是小人疏忽，忘了拴好这倒霉马。它是个畜生，不懂人事，大人莫怪。",
          "relativeStartFrame": 67,
          "absoluteStartFrame": 5011,
