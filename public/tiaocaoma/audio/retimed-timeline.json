      "segments": [
        {
          "id": "exception-09-narr",
          "speaker": "旁白",
          "staticPath": "tiaocaoma/audio/voice/exception-09-narr.mp3",
          "text": "话里带着刺。",
          "relativeStartFrame": 0,
          "absoluteStartFrame": 4704,
          "durationInFrames": 38
        },
        {
          "id": "exception-09-dlg-01",
          "speaker": "赵大人",
          "staticPath": "tiaocaoma/audio/voice/exception-09-dlg-01.mp3",
          "text": "不知这瘸马是哪位大人的宝驹？难道今日店里还有一品大员，我竟没瞧见？",
          "relativeStartFrame": 46,
          "absoluteStartFrame": 4750,
          "durationInFrames": 181
        }
      ]
    },
    {
      "id": "exception-10",
      "actId": "exception",
